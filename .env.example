# Public app domain used by SuperTokens websiteDomain.
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3000

# Auth API origin. For RapidMVP-style first-party auth, keep this equal to website domain.
# Production example:
# NEXT_PUBLIC_AUTH_API_URL=https://ooocreatives.com
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3000

# Shared CRUD/profile API
# Production example:
# NEXT_PUBLIC_API_URL=https://api.rapidmvp.io
NEXT_PUBLIC_API_URL=http://localhost:3000

# SuperTokens Core is hosted at https://auth.rapidmvp.io/core — no API key required.

# MovieShaker database password (DigitalOcean managed PostgreSQL)
MOVIESHAKER_DB_PASSWORD=your-db-password

# DigitalOcean Spaces Configuration (for carousel image storage)
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_NAME=your-space-name
DO_SPACES_REGION=nyc3
DO_SPACES_ACCESS_KEY=your-access-key
DO_SPACES_SECRET_KEY=your-secret-key
